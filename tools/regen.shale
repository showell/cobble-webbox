-- **GAMESERVER.CODEX AS A ZIG LIBRARY** (src/gen/games.zig): Damian's game
-- server, transpiled by codexzig and reshaped by hand-kept rules into what
-- a host calls rather than runs. Until the ZigEmitter has a library mode,
-- this script is that mode, one rule per step, each refusing to apply
-- anywhere but exactly once:
--
--   1. codexzig, built (Zig 0.16) from codex-zig-transpiler's checked-in
--      generated/codexzig.qemu.zig, into .zig-cache/, when missing;
--   2. the unit: apps/games/GameServer.codex with everything it cites, by
--      the checkout's own bundler (build/bundle-app.ps1);
--   3. the Zig, and the library rules: the compiler's diagnostics out of
--      the stream; no entry and no `main` (`opening` is a program's, not a
--      library's); the overflow guard in a form Zig 0.16 and 0.17 both
--      take; `cx_print_line` through a host's hook; and the face a host
--      calls (src/games_api.zig.in) appended.
--
--   cd ~/showell_repos/cobble-webbox && shale tools/regen.shale
--
-- `cobble` is the Cobblestone checkout (default the box's `cobble:` mount,
-- ~/showell_repos/cobblestone-pin), `transpiler` codex-zig-transpiler's.
--
-- budget: steps=200000000 arena_bytes=1500000000

const COBBLE = arg("cobble", "cobble:")
const TRANSPILER = arg("transpiler", "repos:codex-zig-transpiler")
const ZIG016 = arg("zig016", "zig016:zig")
const PWSH = arg("pwsh", "/home/steve/.local/pwsh/pwsh")

-- `rel` under `dir`; a mount's own root (`cobble:`) takes it without a
-- leading `/`.
function under(dir, rel)
  if ends_with(dir, ":") then return dir .. rel end
  return dir .. "/" .. rel
end

-- `old` replaced by `new` in `text`, where it is exactly once.
function once(text, old, new, what)
  local n = #split(text, old) - 1
  if n ~= 1 then fail("regen: " .. what .. ": found " .. n .. " times, not once") end
  return substitute(text, old, new)
end

-- 1. codexzig
local codexzig = ".zig-cache/codexzig"
if not exists(codexzig) then
  print("building codexzig from " .. TRANSPILER .. "'s generated/codexzig.qemu.zig (Zig 0.16, ~2 min)")
  mkdir(".zig-cache")
  must(run({real(ZIG016), "build-exe", real(under(TRANSPILER, "generated/codexzig.qemu.zig")), "-O", "ReleaseSafe", "-femit-bin=codexzig"}, {cwd = ".zig-cache", timeout_ms = 900000, tail = 20}))
end

-- 2. the unit
local unit = ".zig-cache/gameserver-unit.codex"
must(run({PWSH, "-NoProfile", "-File", real(under(COBBLE, "build/bundle-app.ps1")), "-Src", real(under(COBBLE, "apps/games/GameServer.codex")), "-Out", real(".") .. "/" .. unit}, {timeout_ms = 300000, tail = 3, want = "pwsh-bundle: the Cobblestone checkout's own bundler is PowerShell"}))

-- 3. the Zig. codexzig writes the program and its diagnostics to the same
-- stream; a diagnostic line is never Zig.
local r = must(run({real(codexzig)}, {timeout_ms = 600000, whole = 67108864, stdin = read(unit), want = "codexzig: built into .zig-cache by this script"}))
local kept = {}
local dropped = 0
for l in lines(r.out) do
  if starts_with(l, "CDX") or starts_with(l, "codexzig:") then dropped = dropped + 1 else push(kept, l) end
end
local zig = join(kept, "\n")

local entry_from = find(zig, "fn cx_entry() void {")
local main_end = "    t.join();\n}\n"
local entry_to = find(zig, main_end)
if entry_from == nil or entry_to == nil then fail("regen: no entry and main to take out") end
zig = sub(zig, 1, entry_from - 1) .. [=[comptime {
    // Library mode: the overflow guard, in a form Zig 0.16 and 0.17 both take
    // (0.17 has no `.ReleaseFast` field: its modes are `.fast` and `.small`).
    if (!@import("std").debug.runtime_safety) @compileError("emitted Codex traps on Integer overflow through zig's safety checks; build it Debug or ReleaseSafe");
}
]=] .. sub(zig, entry_to + #main_end)

zig = once(zig, [=[fn cx_print_line(s: []const u8) void {
    std.debug.print("{s}\n", .{cx_cce_to_utf8(s)});
}]=], [=[fn cx_print_line(s: []const u8) void {
    if (cx_host_print) |p| return p(cx_cce_to_utf8(s));
    std.debug.print("{s}\n", .{cx_cce_to_utf8(s)});
}
/// Library mode: a host's own print for the chapter's Console lines; null,
/// stderr as a program's.
pub var cx_host_print: ?*const fn ([]const u8) void = null;]=], "cx_print_line")

local rev = trim(must(run({"git", "-C", real(COBBLE), "rev-parse", "--short=12", "HEAD"}, {timeout_ms = 10000, tail = 1})).out)
local head = "// GENERATED by tools/regen.shale from apps/games/GameServer.codex at Cobblestone " .. rev .. ",\n// through codexzig: do not edit; change the script or src/games_api.zig.in and run it again.\n\n"
replace("src/gen/games.zig", head .. zig .. "\n" .. read("src/games_api.zig.in"))
print("src/gen/games.zig: " .. #lines(read("src/gen/games.zig")) .. " lines, from " .. stat(unit).size .. " bytes of Codex at " .. rev .. " (" .. dropped .. " diagnostic lines left out)")
