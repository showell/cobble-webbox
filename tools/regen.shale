-- **COBBLESTONE'S CODEX AS ZIG LIBRARIES** (src/gen/*.zig): each
-- application's Codex root, with everything it cites, transpiled by
-- codexzig in the ZigEmitter's library mode. A host calls a library's
-- exports (`pub fn`), and its `cx` face for the heap and for text across
-- the edge; src/*_api.zig wraps them for the sites.
--
--   1. codexzig, built (Zig 0.16) from codex-zig-transpiler's checked-in
--      generated/codexzig.qemu.zig, into .zig-cache/, when missing
--      (tools/codexzig.shale rebuilds it from the checkout);
--   2. per application in APPS, the unit: its root with everything it
--      cites, by the checkout's own bundler (build/bundle-app.ps1), and a
--      `zig-library` declaration naming its exports after it. The build
--      declares it, not the chapter, so a chapter that is a program to
--      another build (GameServer, server.ps1's) is a library to this one;
--   3. the Zig, the compiler's diagnostics left out of the stream.
--
--   cd ~/showell_repos/cobble-webbox && shale tools/regen.shale
--
-- `cobble` is the Cobblestone checkout (default the box's `cobble:` mount,
-- ~/showell_repos/cobblestone-pin), `transpiler` codex-zig-transpiler's.
--
-- budget: steps=400000000 arena_bytes=2500000000

const COBBLE = arg("cobble", "cobble:")
const TRANSPILER = arg("transpiler", "repos:codex-zig-transpiler")
const ZIG016 = arg("zig016", "zig016:zig")
const PWSH = arg("pwsh", "/home/steve/.local/pwsh/pwsh")

-- **THE APPLICATIONS**: each its Codex root (in the checkout), the library
-- written, and the exports its host calls.
const APPS = {
  {name = "games", root = "apps/games/GameServer.codex", out = "src/gen/games.zig", exports = {"game-store-new", "dispatch-request"}},
  {name = "ideas", root = "apps/ideas/IdeaWeb.codex", out = "src/gen/ideas.zig", exports = {"idea-state-new", "idea-route-at"}},
  {name = "chat", root = "apps/chat/ChatStore.codex", out = "src/gen/chat.zig",
   exports = {"chat-state-new", "chat-route", "chat-store-load", "chat-store-mark", "chat-store-save"}},
  {name = "uo", root = "apps/uoaix/proofs/GameVendorReplay.codex", out = "src/gen/uo.zig", exports = {"opening"}},
  {name = "uo-town", root = "apps/uoaix/proofs/TownLiveProof.codex", out = "src/gen/uo_town.zig", exports = {"opening"}},
  {name = "uo-watch", root = "apps/uoaix/TownWatch.codex", out = "src/gen/uo_watch.zig",
   exports = {"tw-new", "tw-tick", "tw-json", "tw-map-json", "tw-join", "tw-leave", "tw-goal", "tw-greet", "tw-valid", "tw-say", "tw-offers", "tw-buy", "tw-errand"}},
}

-- The chapter that makes a unit a library: `zig-library` (the ZigEmitter's
-- library mode) naming the exports, `|a|b|`.
function library_chapter(exports)
  return "\n\nChapter: Zig Library\n\n The exports a host calls: this unit is built as a library.\n\n  zig-library : Text = \"|" .. join(exports, "|") .. "|\"\n"
end

-- `rel` under `dir`; a mount's own root (`cobble:`) takes it without a
-- leading `/`.
function under(dir, rel)
  if ends_with(dir, ":") then return dir .. rel end
  return dir .. "/" .. rel
end

-- 1. codexzig
local codexzig = ".zig-cache/codexzig"
if not exists(codexzig) then
  print("building codexzig from " .. TRANSPILER .. "'s generated/codexzig.qemu.zig (Zig 0.16, ~2 min)")
  mkdir(".zig-cache")
  must(run({real(ZIG016), "build-exe", real(under(TRANSPILER, "generated/codexzig.qemu.zig")), "-O", "ReleaseSafe", "-femit-bin=codexzig"}, {cwd = ".zig-cache", timeout_ms = 900000, tail = 20}))
end

local rev = trim(must(run({"git", "-C", real(COBBLE), "rev-parse", "--short=12", "HEAD"}, {timeout_ms = 10000, tail = 1})).out)

for app in APPS do
  -- 2. the unit
  local unit = ".zig-cache/" .. app.name .. "-unit.codex"
  must(run({PWSH, "-NoProfile", "-File", real(under(COBBLE, "build/bundle-app.ps1")), "-Src", real(under(COBBLE, app.root)), "-Out", real(".") .. "/" .. unit}, {timeout_ms = 300000, tail = 3, want = "pwsh-bundle: the Cobblestone checkout's own bundler is PowerShell"}))

  -- 3. the Zig. codexzig writes the program and its diagnostics to the
  -- same stream; a diagnostic line is never Zig.
  local r = must(run({real(codexzig)}, {timeout_ms = 600000, whole = 67108864, stdin = read(unit) .. library_chapter(app.exports), want = "codexzig: built into .zig-cache by this script"}))
  local kept = {}
  local dropped = 0
  for l in lines(r.out) do
    if starts_with(l, "CDX") or starts_with(l, "codexzig:") then dropped = dropped + 1 else push(kept, l) end
  end
  local zig = join(kept, "\n")
  if find(zig, "pub const cx = struct {") == nil then fail("regen: " .. app.name .. ": no library face; is codexzig built with the library mode?") end

  local head = "// GENERATED by tools/regen.shale from " .. app.root .. " at Cobblestone " .. rev .. ",\n// through codexzig's library mode: do not edit; change the script and run it again.\n\n"
  replace(app.out, head .. zig .. "\n")
  print(app.out .. ": " .. #lines(read(app.out)) .. " lines, from " .. stat(unit).size .. " bytes of Codex at " .. rev .. " (" .. dropped .. " diagnostic lines left out)")
end
