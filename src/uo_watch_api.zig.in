// ========================================================================
// UOAIX'S TOWNWATCH'S FACE (cobble-webbox, src/uo_watch_api.zig.in,
// appended by tools/regen.shale after src/library.zig.in).
// ========================================================================

/// What a host calls: apps/uoaix/TownWatch.codex, a town kept between
/// calls. Texts come back UTF-8 on the Codex heap: a host copies them out
/// before it gives the heap back past them.
pub const api = struct {
    pub const Watch = TownWatch;

    /// Bytes of the Codex heap in use since its base.
    pub fn heapUsed() i64 {
        return cx_hp - cx_heap_floor;
    }
    const cx_heap_floor: i64 = 6291456;

    /// The frontier now, to go back to: everything allocated after it is
    /// given back by `heapBack`, so nothing kept may live there.
    pub fn heapMark() i64 {
        return cx_hp;
    }

    pub fn heapBack(mark_at: i64) void {
        if (mark_at < cx_heap_floor or mark_at > cx_hp) @panic("uo watch: a heap mark that is not behind the frontier");
        cx_hp = mark_at;
    }

    /// The Codex heap's region, given by the host before the first
    /// allocation and kept for the process: zeroed, as bare metal's boot
    /// zero-fills its heap. Giving the same region again changes nothing.
    pub fn heapGive(region: []align(4096) u8) void {
        if (cx_heap_mem.len != 0) {
            if (cx_heap_mem.ptr == region.ptr and cx_heap_mem.len == region.len) return;
            @panic("uo watch: the heap already has its region");
        }
        cx_heap_mem = region;
        cx_heap_reserve = region.len;
    }

    /// The town, built: everything it keeps is below the frontier after.
    pub fn new() Watch {
        return tw_new(0);
    }

    /// Why there is no town, or "" when there is one.
    pub fn problem(w: Watch) []const u8 {
        return cx_cce_to_utf8(w.problem);
    }

    /// The town brought to `seconds` of game time; false when a step failed.
    pub fn tick(w: Watch, seconds: i64) bool {
        return tw_tick(w, seconds);
    }

    /// Where everyone is now, as JSON.
    pub fn json(w: Watch, seconds: i64) []const u8 {
        return cx_cce_to_utf8(tw_json(w, seconds));
    }

    /// The map's bounds and its shops, as JSON.
    pub fn mapJson(w: Watch) []const u8 {
        return cx_cce_to_utf8(tw_map_json(w));
    }
};
