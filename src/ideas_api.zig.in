
// ========================================================================
// IDEA FORGE'S FACE (cobble-webbox, src/ideas_api.zig.in, appended by
// tools/regen.shale after src/library.zig.in).
// ========================================================================

/// What a host calls. The names are IdeaWeb.codex's: the state the house
/// threads from customer to customer, a fresh one, and `idea-route-at`,
/// which takes the caller and the service day from its host (IdeaServer's
/// `resolve-who` and `current-day`, which webbox now answers).
pub const api = struct {
    pub const State = IdeaState;

    pub fn newState() State {
        return idea_state_new();
    }

    /// The next state and the response, its texts UTF-8.
    pub const Answer = struct { state: State, status: []const u8, content_type: []const u8, body: []const u8 };

    /// One request: its method, its target (path and query, as the line
    /// carries it) and its body, all ASCII, from caller `who` on service day
    /// `day`.
    pub fn route(state: State, who: []const u8, day: i64, method: []const u8, target: []const u8, body: []const u8) error{NotAscii}!Answer {
        const req = cx_new(HttpRequestS{
            .method = try asciiToCce(method),
            .path_ = try asciiToCce(target),
            .body = try asciiToCce(body),
            .valid = true,
        });
        const pair = idea_route_at(state, try asciiToCce(who), day, req);
        switch (pair.*) {
            .MkTup2 => |t| return .{
                .state = t[0],
                .status = cx_cce_to_utf8(t[1].status),
                .content_type = cx_cce_to_utf8(t[1].content_type),
                .body = cx_cce_to_utf8(t[1].body),
            },
        }
    }
};
