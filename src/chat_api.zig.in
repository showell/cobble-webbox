
// ========================================================================
// CODEX CHAT'S FACE (cobble-webbox, src/chat_api.zig.in, appended by
// tools/regen.shale after src/library.zig.in).
// ========================================================================

/// What a host calls. The names are ChatServer.codex's and ChatStore.codex's:
/// the state, a fresh one, the state as the disk holds it, a mark before a
/// route and what the route changed written against it, and `chat-route`,
/// which takes the time of day and a fresh token from its host as
/// ChatServer's prose says.
pub const api = struct {
    pub const State = ChatState;
    pub const Mark = ChatStoreMark;
    pub const FileHost = CxFileHost;

    /// The files ChatStore keeps through the FileSystem effect: the host's.
    pub fn useFiles(host: ?FileHost) void {
        cx_file_host = host;
    }

    /// Bytes of the Codex heap in use: everything allocated since the
    /// heap's base, garbage included (it is a bump frontier).
    pub fn heapUsed() i64 {
        return cx_hp - cx_heap_floor;
    }
    const cx_heap_floor: i64 = 6291456;

    /// The frontier now, to go back to: everything allocated after it is
    /// given back by `heapBack`, so nothing kept may live there.
    pub fn heapMark() i64 {
        return cx_hp;
    }

    pub fn heapBack(mark_at: i64) void {
        if (mark_at < cx_heap_floor or mark_at > cx_hp) @panic("codex chat: a heap mark that is not behind the frontier");
        cx_hp = mark_at;
    }

    /// Everything given back: nothing from before may be used after it.
    pub fn heapReset() void {
        cx_hp = cx_heap_floor;
    }

    /// The Codex heap's region, in bytes, before its first allocation (it is
    /// taken whole, once). A host with no virtual memory gives what it has.
    pub fn heapRegion(bytes: usize) void {
        if (cx_heap_mem.len != 0) @panic("codex chat: the heap's region is chosen before its first allocation");
        cx_heap_reserve = bytes;
    }

    pub fn heapRegionSize() usize {
        return cx_heap_reserve;
    }

    pub fn newState() State {
        return chat_state_new();
    }

    /// The state in the host's files (under `codex-chat/`), and why they
    /// cannot be trusted with the next write: empty when they can.
    pub const Loaded = struct { state: State, problem: []const u8 };

    pub fn load() Loaded {
        const l = chat_store_load();
        return .{ .state = l.sl_state, .problem = cx_cce_to_utf8(l.sl_problem) };
    }

    /// Taken before a route: what `save` writes is what the route added past
    /// it. (The state before a route is no record of it: list-push writes in
    /// place while a list has room.)
    pub fn mark(state: State) Mark {
        return chat_store_mark(state);
    }

    /// What changed since `m`, written; whether every write went through.
    /// After a False the state in hand holds what the disk does not: `load`
    /// again.
    pub fn save(m: Mark, state: State) bool {
        return chat_store_save(m, state);
    }

    pub const Answer = struct { state: State, status: []const u8, content_type: []const u8, body: []const u8 };

    /// One request (method, target, body: ASCII), at `time` (`HH:mm`), with
    /// a fresh token for the account it may make.
    pub fn route(state: State, time: []const u8, token: []const u8, method: []const u8, target: []const u8, body: []const u8) error{NotAscii}!Answer {
        const host = cx_new(ChatHostS{
            .ch_time = try asciiToCce(time),
            .ch_token = try asciiToCce(token),
        });
        const req = cx_new(HttpRequestS{
            .method = try asciiToCce(method),
            .path_ = try asciiToCce(target),
            .body = try asciiToCce(body),
            .valid = true,
        });
        const pair = chat_route(state, host, req);
        switch (pair.*) {
            .MkTup2 => |t| return .{
                .state = t[0],
                .status = cx_cce_to_utf8(t[1].status),
                .content_type = cx_cce_to_utf8(t[1].content_type),
                .body = cx_cce_to_utf8(t[1].body),
            },
        }
    }
};
